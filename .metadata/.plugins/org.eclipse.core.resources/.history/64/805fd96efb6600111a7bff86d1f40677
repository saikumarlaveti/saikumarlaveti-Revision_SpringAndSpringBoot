package com.Controller;

import java.util.Date;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Controller;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.servlet.ModelAndView;

import com.Service.WishService;

@Controller
public class WishController {

	@Autowired
	public WishService wish;
	
	@RequestMapping("/wish")
	public ModelAndView wishMessage(String name) {
		String result = wish.wishMessage("Saikumar Laveti");
		
		ModelAndView mav = new ModelAndView();
		mav.addObject("wMsg",result);
		mav.addObject("sysdate",new Date());
		mav.setViewName("wish");
		return mav;
	}
}
